{
  "metadata": { "workflows_module_schema_version": "1.0.0" },
  "fields": [
    {
      "id": "spreadsheet_id",
      "type": "object",
      "label": "Spreadsheet",
      "ui_options": { "ui_widget": "SelectWidget", "refresh_on_change": true, "placeholder": "Select a spreadsheet" },
      "choices": { "values": [] },
      "content": { "type": ["managed"], "content_objects": [{ "id": "spreadsheets" }] },
      "validation": { "required": true }
    },
    {
      "id": "sheet_name",
      "type": "object",
      "label": "Sheet / Tab",
      "ui_options": { "ui_widget": "SelectWidget", "placeholder": "Select a tab" },
      "choices": { "values": [] },
      "content": {
        "type": ["managed"],
        "content_objects": [
          { "id": "sheets", "content_object_depends_on_fields": [{ "id": "spreadsheet_id" }] }
        ]
      },
      "validation": { "required": true }
    },
    {
      "id": "match_key",
      "type": "string",
      "label": "Match Column (header name)",
      "ui_options": { "placeholder": "e.g. Email or ID" }
    },
    {
      "id": "match_value",
      "type": "string",
      "label": "Match Value",
      "ui_options": { "placeholder": "Value to match in that column" }
    },
    {
      "id": "upsert_if_missing",
      "type": "boolean",
      "label": "If not found, append as new row",
      "default": true
    },
    {
      "id": "values_json",
      "type": "string",
      "label": "Row Data (object or array of one object)",
      "default": "{\"Email\":\"s.kay@example.com\",\"First\":\"Sarah\",\"Last\":\"Kay\",\"Age\":29}",
      "ui_options": {
        "ui_widget": "CodeblockWidget",
        "ui_options": { "language": "json" },
        "placeholder": "{\"Email\":\"john@example.com\",\"First\":\"John\"}"
      },
      "validation": { "required": true }
    },
    {
      "id": "value_input_option",
      "type": "string",
      "label": "Value Input Option",
      "enum": ["USER_ENTERED", "RAW"],
      "default": "USER_ENTERED"
    }
  ],
  "ui_options": {
    "ui_order": ["spreadsheet_id", "sheet_name", "match_key", "match_value", "upsert_if_missing", "values_json", "value_input_option"]
  }
}
